{
  // Finds files, exports and types in src that nothing uses, and packages that
  // package.json lists but nothing imports, or that code imports but
  // package.json does not list. Run `npm run knip`.
  // Everything outside src is an entry point, so a src export that only the
  // server, a script or a test imports counts as used.
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "server/**/*.ts",
    "shared/**/*.ts",
    "scripts/**/*.{ts,mjs}",
    "tests/**/*.{ts,tsx}",
  ],
  "project": ["src/**/*.{ts,tsx}"],
  // src/index.css loads these with `@import` and `@plugin`, which knip does
  // not read.
  "ignoreDependencies": ["tailwindcss", "@tailwindcss/typography"],
  "rules": {
    "duplicates": "off",
  },
}
