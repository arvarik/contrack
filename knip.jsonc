{
  // Finds files, exports and types in src that nothing uses. Run `npm run knip`.
  // Everything outside src is an entry point, so a src export that only the
  // server, a script or a test imports counts as used.
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "server/**/*.ts",
    "shared/**/*.ts",
    "scripts/**/*.{ts,mjs}",
    "tests/**/*.{ts,tsx}",
  ],
  "project": ["src/**/*.{ts,tsx}"],
  // Only dead code is checked. Dependencies and duplicate exports are not.
  "rules": {
    "duplicates": "off",
    "dependencies": "off",
    "devDependencies": "off",
    "optionalPeerDependencies": "off",
    "unlisted": "off",
    "binaries": "off",
    "unresolved": "off",
  },
}
