# eslint-plugin-jsx-a11y (6.10.2, its latest) declares peer support only up
# to eslint 9, while this project uses eslint 10 — a hard ERESOLVE failure on
# a plain `npm install`. The plugin works fine on 10; only the declaration
# lags. This flag makes `npm install` and `npm ci` work exactly as the README
# writes them, matching what the Dockerfile and CI already pass explicitly.
# Remove when jsx-a11y publishes an eslint-10-compatible release.
legacy-peer-deps=true
