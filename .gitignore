# Dependencies
node_modules/

# Build output
build/
dist/
coverage/
.vitest/

# Environment variables
.env*
!.env.example

# Database files — local only, never commit
*.db
*.db-shm
*.db-wal

# Runtime data directory (DATA_DIR): database, auth token, backups,
# uploads, and the embedding-model cache. All machine-local secrets/state.
data/

# The key that seals stored credentials. Outside Docker DATA_DIR is the
# project root, so the server writes it here, beside the code. Anyone who has
# it can read every stored API key, password and OAuth token.
secret.key

# Local model files from `npm run models:fetch` (MODEL_DIR defaults to
# DATA_DIR/models), and the model cache when DATA_DIR is the project root.
/models/
/.cache/

# Database snapshots. These are full copies of the contact database. Today
# they are all *.db and would be caught above, but that is incidental — a
# compressed or manifest file would not be, so ignore the directory itself.
backups/

# User-uploaded files
uploads/

# OS files
.DS_Store
Thumbs.db

# Editor / IDE config
.vscode/
.idea/
*.swp
*.swo
.cursorrules
.obsidian/
**/.obsidian/

# Test / scratch artifacts
test.eml

# Playwright output: the HTML report, traces, and screenshots of failures
playwright-report/
test-results/
blob-report/

# Working reviews — running scratchpads of proposals, not shipped docs
docs/ui-ux-review.md
docs/backend-surface-gaps.md

# Gemstack-managed internal design docs — not shipped
docs/archive/
docs/designs/
docs/explorations/
docs/plans/
docs/recommendations/
docs/multi-tenant-plan/

# 2.0 line-item plans: context, code references and agent prompts per item
docs/v2/
