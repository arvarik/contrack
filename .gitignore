# Dependencies
node_modules/

# Build output
build/
dist/
coverage/

# Environment variables
.env*
!.env.example

# Database files — local only, never commit
*.db
*.db-shm
*.db-wal

# Runtime data directory (DATA_DIR): database, auth token, backups,
# uploads, and the embedding-model cache. All machine-local secrets/state.
data/

# Database snapshots. These are full copies of the contact database. Today
# they are all *.db and would be caught above, but that is incidental — a
# compressed or manifest file would not be, so ignore the directory itself.
backups/

# User-uploaded files
uploads/

# OS files
.DS_Store
Thumbs.db

# Editor / IDE config
.vscode/
.idea/
*.swp
*.swo
.cursorrules

# Test / scratch artifacts
test.eml

# Working reviews — running scratchpads of proposals, not shipped docs
docs/ui-ux-review.md
docs/backend-surface-gaps.md

# Gemstack-managed internal design docs — not shipped
docs/archive/
docs/designs/
docs/explorations/
docs/plans/
docs/recommendations/
