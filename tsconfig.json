{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./*"]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true,

    /* Strictness — keep these on. `strict` enables noImplicitAny,
       strictNullChecks, strictFunctionTypes, useUnknownInCatchVariables, etc.
       NOTE: `any` bypasses these checks entirely — that's why the
       no-explicit-any lint rule is an error, not a warning. */
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true
  },
  "include": ["src", "server", "tests", "scripts", "*.ts"],
  "exclude": ["node_modules", "dist", "data", "uploads"]
}
