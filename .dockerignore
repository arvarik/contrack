# Dependencies — reinstalled inside the image for the correct platform
node_modules

# VCS / editor
.git
.github
.vscode
.idea
.agent
.claude
.husky
.devcontainer
.gitignore
.nvmrc
.tool-versions
.oxlintrc.json
.prettierignore

# Secrets — must never enter image layers
.env
.env.*
!.env.example

# Local data — databases, backups, uploads, keys, model caches. The patterns
# need **/ to reach below the root: `*.db` alone let backups/*.db (gigabytes
# of contact data) into the build context, and the builder's COPY . . put
# them in a layer.
**/*.db
**/*.db-shm
**/*.db-wal
**/*.db.json
backups
uploads
data
models
.cache
secret.key
*.key

# Build and test output — rebuilt inside the image, or not needed
dist
coverage
test-results
playwright-report

# Docs, tests, and tooling not needed at build/runtime
docs
tests
scripts
# The documented password recovery, which the image runs, the model download,
# which the build stage runs, and the model check, which the image runs.
!scripts/reset-password.ts
!scripts/fetch-models.ts
!scripts/model-smoke.ts
Dockerfile
docker-compose.yml
.dockerignore
AGENTS.md
CHANGELOG.md
CODE_OF_CONDUCT.md
CONTRIBUTING.md
LICENSE
README.md
SECURITY.md
knip.jsonc
playwright.config.ts
vitest.config.ts

# OS noise
.DS_Store
