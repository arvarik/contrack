# =============================================================================
# Contrack configuration
# =============================================================================
# Every line is optional. With no .env at all, Contrack runs at
# http://localhost:3210, and contacts and semantic search work on a built-in
# local model.
#
# Most settings live in the app, not in this file:
#   Settings → Administration → AI
#                              provider keys, OpenAI-compatible servers, the
#                              models, web search and SearXNG
#   Settings → Administration  outgoing mail, Google connector, trash
#                              retention, backups
# A variable set here overrides the app's setting and locks its field. The
# models are the exception: a model pinned on the AI page wins.
#
# docs/configuration.md lists every variable, with its default.

# ── AI ──────────────────────────────────────────────────────────────────────
# One key turns on the AI features, and Contrack picks each model.
# A key entered in Settings → Administration → AI works the same
# way, and it is stored encrypted. A key set here wins over one entered there.
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# AI_DISABLED: "true" turns AI off for the whole instance. No request reaches
# any AI provider, whatever keys are stored. Local search keeps working.
# AI_DISABLED="false"

# The models: AI_QUICK_MODEL is the Fast model, AI_DEEP_MODEL the Strong
# model, AI_RESEARCH_MODEL the web search model and AI_EMBEDDINGS_MODEL the
# embedding model. Settings → Administration → AI is the easier place, and a
# model pinned there wins over these. They serve setups that never open the
# UI. A value is a model name, or "provider:model" such as
# "anthropic:claude-sonnet-5". Unset means Contrack picks.
# AI_QUICK_MODEL=""
# AI_DEEP_MODEL=""
# AI_RESEARCH_MODEL=""
# AI_EMBEDDINGS_MODEL=""

# Ask Contrack's local cross-encoder reorders the top of the local list for a
# question, on this machine, with no key. "off" turns it off. The budget is
# the most milliseconds it may add. Later scores are dropped, and the list
# keeps its fused order.
# SEARCH_RERANK_MODEL="Xenova/ms-marco-TinyBERT-L-2-v2"
# SEARCH_RERANK_BUDGET_MS="25"

# MODEL_DOWNLOADS: "false" keeps the server from downloading model files from
# huggingface.co. Run `npm run models:fetch` first, which puts the search
# models in MODEL_DIR (default DATA_DIR/models).
# MODEL_DOWNLOADS="true"
# MODEL_DIR=""

# ── Network ─────────────────────────────────────────────────────────────────
# HOST: the interface to bind. The default is this machine only. Docker sets
# "0.0.0.0" itself.
# HOST="127.0.0.1"
# PORT="3210"

# PUBLIC_URL: the address people open, when a reverse proxy sits in front,
# for example "https://crm.example.com", with no path and no trailing slash.
# Passkeys, invitation links and the Google connector need it, and mail sends
# no sign-in, reset or invitation link without it.
# PUBLIC_URL=""

# TRUST_PROXY_HOPS: how many reverse proxies sit in front. "0" believes no
# X-Forwarded-* header. Set "1" behind one proxy, so rate limits and the audit
# log see the real client address and HTTPS requests count as secure.
# TRUST_PROXY_HOPS="0"

# ── Sign-in ─────────────────────────────────────────────────────────────────
# AUTH_REQUIRED: "true" makes everyone sign in with an account. The first
# visit creates the first account. Turn it on when anything other than this
# machine can reach the port.
# AUTH_REQUIRED="false"

# ── Data ────────────────────────────────────────────────────────────────────
# DATA_DIR: the folder for the database, uploads, backups and the model
# cache. The default is the project folder. Docker uses /app/data.
# DATA_DIR=""

# CONTRACK_SECRET_KEY: 64 hex characters. It encrypts the credentials the
# database stores: AI keys, the SMTP password, connector feeds. Unset means a
# key generated in DATA_DIR/secret.key. Back that file up with the database,
# because a restored database cannot open its credentials without it.
# Generate one with: openssl rand -hex 32
# CONTRACK_SECRET_KEY=""

# ── Background jobs ─────────────────────────────────────────────────────────
# JOB_CONCURRENCY: the most background jobs that run at once, such as a
# backup, the daily sweep or a duplicate check. An integer of at least 1.
# JOB_CONCURRENCY="2"
