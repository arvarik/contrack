# =============================================================================
# AI Provider Configuration
# =============================================================================

# AI_PROVIDER: Which LLM provider adapter to use. Default: "gemini".
# Supported: "gemini", "openai", "anthropic".
AI_PROVIDER="gemini"

# GEMINI_API_KEY: Required when AI_PROVIDER="gemini" (default).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Required when AI_PROVIDER="openai".
# Get your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# ANTHROPIC_API_KEY: Required when AI_PROVIDER="anthropic".
# Get your key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# AI_TIER: Controls rate limit profiles and routing behavior.
# "FREE"  — Conservative routing, limits matching Google's free tier (~10 RPM).
#           Avoids paid spillover by default. Best-effort, not a billing guarantee.
# "PAID"  — Aggressive routing, full paid-tier limits (10K+ RPM).
#           Includes paid-only models (e.g., Gemini 3.x preview).
# Default: "FREE"
AI_TIER="FREE"

# =============================================================================
# Application Configuration
# =============================================================================

# PORT: The port the Express server listens on.
PORT="3210"

# HOST: The interface to bind. The server has NO authentication, so it binds
# localhost by default. Set to "0.0.0.0" to expose on your LAN or in Docker
# (the Docker image sets this automatically).
# HOST="127.0.0.1"

# CORS_ORIGIN: Optional. Enables CORS for the given origin. Disabled by
# default — the SPA is served same-origin, so browsers don't need CORS.
# CORS_ORIGIN=""

# DATA_DIR: Optional. Root directory for runtime data (curator.db, uploads/,
# embedding model cache). Defaults to the project root; Docker sets /app/data.
# DATA_DIR=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3210"

# MAPBOX_API_KEY: Optional. If provided, replaces Nominatim as the primary
# geocoding engine for extremely accurate geolocation points.
MAPBOX_API_KEY=""
