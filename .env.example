# =============================================================================
# Minimum setup
# =============================================================================
# The true minimum is NO key at all: contact management and semantic search
# run on a built-in local model, and you can connect a provider later from
# Settings → AI — an API key, or a self-hosted OpenAI-compatible endpoint
# (Ollama, vLLM, LM Studio) with no key anywhere.
#
# To enable the AI features from the start, one API key is all you need.
# Contrack routes each kind of AI work to a suitable model on its own — no
# model configuration required. Any one of these works; add several to mix
# providers across tasks.

GEMINI_API_KEY=""
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""

# Everything below is optional and commented out. The defaults are sensible.

# =============================================================================
# AI — optional
# =============================================================================

# AI_PROVIDER: preferred provider when a task is set to Auto. Only meaningful
# if you have more than one key configured. Default: "gemini".
# AI_PROVIDER="gemini"

# AI_TIER: rate-limit profile for Gemini's model routing.
#   "FREE"  — conservative, matches Google's free-tier limits (~10 RPM).
#   "PAID"  — full paid-tier limits, includes paid-only models.
# AI_TIER="FREE"

# ── Advanced: pin a model per task ───────────────────────────────────────────
# Settings → AI Configuration is the easier place to do this, and it applies
# without a restart. These exist for deployments configured declaratively that
# never open the UI. A pin made in Settings takes precedence over these.
#
# Accepts a bare model name ("gemini-3.6-flash") or "provider:model"
# ("anthropic:claude-sonnet-5"). Leave unset to let Contrack choose.
#
# Quick tasks    — Magic Paste, @mentions, search understanding, daily insights
# AI_QUICK_MODEL=""
# Deep tasks     — email summaries, duplicate adjudication, research extraction
# AI_DEEP_MODEL=""
# Web research   — AI Search enrichment (needs a provider with search grounding)
# AI_RESEARCH_MODEL=""
# Embeddings     — semantic search + duplicate similarity. Defaults to a local
#                  model that needs no key and works offline.
# AI_EMBEDDINGS_MODEL=""

# =============================================================================
# Server — optional
# =============================================================================

# PORT: the port the Express server listens on. Default: 3210.
# PORT="3210"

# HOST: the interface to bind. Without auth configured the server binds
# localhost. Set "0.0.0.0" to expose on your LAN (Docker sets this itself).
# HOST="127.0.0.1"

# PUBLIC_URL: canonical external origin of the server (e.g. "https://crm.example.com").
# Required for WebAuthn/passkey ceremonies and invitation links when running behind
# a reverse proxy. Must include protocol and hostname, without a path or trailing slash.
# PUBLIC_URL=""

# CORS_ORIGIN: enables CORS for the given origin. Off by default — the SPA is
# served same-origin, so browsers don't need it.
# CORS_ORIGIN=""

# DATA_DIR: root for runtime data (curator.db, uploads/, backups/, model
# cache). Defaults to the project root; the Docker image sets /app/data.
# DATA_DIR=""

# =============================================================================
# Authentication — optional, recommended when HOST is not localhost
# =============================================================================
# Two credential kinds, for two different callers:
#
#   AUTH_REQUIRED  gates the app and turns on the sign-in screen. People sign
#                  in with an account (username or email + password), created
#                  through a one-time setup screen on first visit.
#
#   API_TOKEN      a shared secret for scripts and MCP clients, sent as
#                  "Authorization: Bearer <token>". Setting it also gates the
#                  app, since a token only means something on a gated instance.
#
# Both are off by default, in Docker as well. Turn AUTH_REQUIRED on whenever
# the port is reachable by anything other than this machine.

# AUTH_REQUIRED: "true" requires everyone to sign in with an account.
# AUTH_REQUIRED="false"

# API_TOKEN: machine credential for scripts, cron jobs and MCP clients.
# Generate one with: openssl rand -hex 32
# API_TOKEN=""

# AUTH_TOKEN: the former name for API_TOKEN, from before accounts existed.
# Still honoured, with a deprecation warning at startup. Rename it.
# AUTH_TOKEN=""

# =============================================================================
# Data lifecycle — optional
# =============================================================================

# TRASH_RETENTION_DAYS: days a deleted contact stays restorable. Default: 30.
# TRASH_RETENTION_DAYS="30"

# BACKUP_INTERVAL_HOURS / BACKUP_KEEP: automatic SQLite snapshots into
# DATA_DIR/backups. 0 disables the schedule. Defaults: every 24h, keep 7.
# BACKUP_INTERVAL_HOURS="24"
# BACKUP_KEEP="7"

# DISABLE_BACKGROUND_JOBS: "true" turns off all scheduled work — backups,
# trash purge, geocoding, model-catalog refresh, PRAGMA optimize. Meant for
# CI and for second instances pointed at the same data.
# DISABLE_BACKGROUND_JOBS="false"

# =============================================================================
# Integrations — optional
# =============================================================================

# MAPBOX_API_KEY: replaces Nominatim as the primary geocoder for higher
# accuracy. Nominatim remains the fallback.
# MAPBOX_API_KEY=""

# MAP_STYLE_LIGHT / MAP_STYLE_DARK: the basemap style the map loads in each
# palette. The defaults are OpenFreeMap's public vector styles, which need no
# API key, no registration and have no request limit, so the map works with
# nothing set here.
#
# A value is an absolute https:// URL, or a root-relative path such as
# /map/style.json for a style this app serves from public/. A value that is
# neither logs a warning and the default is used. A root-relative style is
# same-origin, so self-hosting the basemap needs no code change. The style can
# read its tiles from one .pmtiles archive under public/ with the pmtiles://
# protocol. docs/features/map-view.md has the worked example.
# MAP_STYLE_LIGHT="https://tiles.openfreemap.org/styles/positron"
# MAP_STYLE_DARK="https://tiles.openfreemap.org/styles/dark"

# =============================================================================
# Outgoing mail — optional
# =============================================================================

# SMTP_URL: connection URL for outgoing transactional mail (e.g.
# smtp://user:pass@smtp.example.com:587 or smtps://user:pass@smtp.example.com:465).
# When set, this overrides any SMTP configuration set in Settings → Outgoing mail.
# SMTP_URL=""

# MAIL_FROM: sender email address for invitations, password resets, and magic links.
# Defaults to "Contrack <noreply@<host>>" when unset.
# MAIL_FROM=""

# CONTRACK_SECRET_KEY: 32-byte hexadecimal key (64 hex characters) used to encrypt
# stored credentials (like SMTP passwords) in SQLite. When unset, generated at
# DATA_DIR/secret.key on boot with 0600 permissions.
# CONTRACK_SECRET_KEY=""
