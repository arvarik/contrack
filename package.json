{
  "name": "contrack",
  "version": "1.5.3",
  "description": "A local-first, AI-powered personal CRM for high-leverage individuals. Built with React 19, Express, SQLite, and Gemini.",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "author": "Arvind Arik",
  "keywords": [
    "crm",
    "contacts",
    "ai",
    "gemini",
    "local-first",
    "sqlite",
    "react",
    "personal-crm"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arvarik/contrack.git"
  },
  "bugs": {
    "url": "https://github.com/arvarik/contrack/issues"
  },
  "homepage": "https://github.com/arvarik/contrack#readme",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "eslint . && tsc --noEmit",
    "lint:js": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "tsx scripts/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/seedMock.ts",
    "test": "vitest run --project unit --project integration",
    "test:watch": "vitest --project unit --project integration",
    "test:coverage": "vitest run --project unit --project integration --coverage",
    "prepare": "husky",
    "test:contract": "vitest run --project contract",
    "audit:contrast": "node scripts/contrast-audit.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@dicebear/avataaars": "^9.4.2",
    "@dicebear/bottts": "^9.4.2",
