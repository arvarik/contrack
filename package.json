{
  "name": "contrack",
  "version": "1.5.5",
  "description": "A local-first, AI-powered personal CRM for high-leverage individuals. Built with React 19, Express, SQLite, and Gemini.",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "author": "Arvind Arik",
  "keywords": [
    "crm",
    "contacts",
    "ai",
    "gemini",
    "local-first",
    "sqlite",
    "react",
    "personal-crm"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arvarik/contrack.git"
  },
  "bugs": {
    "url": "https://github.com/arvarik/contrack/issues"
  },
  "homepage": "https://github.com/arvarik/contrack#readme",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "eslint . && tsc --noEmit && npm run lint:tenant",
    "lint:tenant": "node scripts/tenant-lint.mjs --strict \"server/**/*.ts\"",
    "lint:js": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "tsx scripts/seed.ts",
    "reset-password": "tsx scripts/reset-password.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/seedMock.ts",
    "test": "vitest run --project unit --project integration --project eval",
    "test:watch": "vitest --project unit --project integration --project eval",
    "test:coverage": "vitest run --project unit --project integration --project eval --coverage",
    "prepare": "husky",
    "test:contract": "vitest run --project contract",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "audit:contrast": "node scripts/contrast-audit.mjs",
    "brand:icons": "tsx scripts/brand/build-icons.ts",
    "tenancy:verify": "tsx scripts/tenancy-verify.ts",
    "eval:record": "tsx scripts/record-search-eval.ts",
    "test:eval": "vitest run --project eval",
    "eval:record:dedupe": "tsx scripts/record-dedupe-eval.ts",
    "eval:record:answer": "tsx scripts/record-answer-eval.ts --record",
    "eval:answer:live": "tsx scripts/record-answer-eval.ts --live"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@dicebear/avataaars": "^9.4.2",
    "@dicebear/bottts": "^9.4.2",
    "@dicebear/core": "^9.4.3",
    "@dicebear/lorelei": "^9.4.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^2.24.0",
    "@huggingface/transformers": "^4.3.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@photostructure/tz-lookup": "^11.7.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@tiptap/extension-mention": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/pm": "^3.22.0",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/suggestion": "^3.31.3",
    "@vis.gl/react-maplibre": "^8.1.3",
    "better-sqlite3": "^12.11.1",
    "canvas-confetti": "^1.9.4",
    "cheerio": "^1.2.0",
    "chrono-node": "^2.10.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.16",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "googleapis": "^181.0.0",
    "imapflow": "^2.0.7",
    "lucide-react": "^0.546.0",
    "mailparser": "^3.9.28",
    "maplibre-gl": "^6.11.2",
    "morgan": "^1.12.1",
    "motion": "^12.43.0",
    "multer": "^2.4.0",
    "node-ical": "^0.27.2",
    "nodemailer": "^10.0.10",
    "openai": "^7.23.0",
    "papaparse": "^5.7.0",
    "pmtiles": "^4.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-dropzone": "^15.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "sharp": "^0.35.4",
    "sonner": "^2.0.8",
    "sqlite-vec": "^0.1.9",
    "tailwind-merge": "^3.7.0",
    "tippy.js": "^6.3.7",
    "undici": "^8.11.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/fontkit": "^2.0.9",
    "@types/mailparser": "^3.4.6",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^25.9.8",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fontkit": "^2.0.4",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^4.1.11",
    "wawoff2": "^2.0.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "adm-zip": "^0.6.1"
  }
}
